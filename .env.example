# Optional custom HTTPS origin. Vercel production uses its assigned production domain automatically.
# Preview deployments remain noindex even when this override is set.
# NEXT_PUBLIC_SITE_URL=https://your-confirmed-domain.example

# Optional approved HTTPS viewing copies. Rebuild after setting these.
# Without URLs or local MP4s, posters provide a working email viewing-request link.
BOUKRA_VIDEO_URL=
OMAN_VIDEO_URL=
